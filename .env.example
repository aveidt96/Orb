# ORB server-side environment template.
# Copy to .env for local use. Never commit a populated .env file.

# Required for explicit local AI testing. Keep the API key on the server only.
ORB_ENV=local
ORB_AI_LOCAL_TESTING=1
ORB_AI_PROVIDER=gemini
# ORB_AI_MODEL=gemini-3.8-flash
GEMINI_API_KEY=
# Or choose ORB_AI_PROVIDER=openai and set OPENAI_API_KEY instead.

# Optional Orb-only local storage overrides. Defaults are shown.
# ORB_OUTPUT_DIR=api_output
# ORB_UPLOAD_DIR=uploads

# Stage 4 Arbitrum Sepolia TESTNET credits. Leave disabled until every setting
# below is configured. Use a dedicated receiving EOA, never a private key.
# Set ORB_AI_LOCAL_TESTING=0 to exercise paid gating on local loopback.
ORB_CREDITS_ENABLED=0
ORB_PUBLIC_ORIGIN=http://127.0.0.1:5174
ORB_ARBITRUM_RPC_URL=
ORB_CREDIT_RECEIVER=
ORB_CREDIT_PRICE_WEI=1000000000000
ORB_PAYMENT_CONFIRMATIONS=3
ORB_CREDIT_DB=api_output/orb_credits.sqlite3

# Default/current main payment method stays native ETH if absent.
# USDG is currently tested only on usdg-test with isolated staging storage.
# Production promotion requires separate approval and the explicit migration.
# Copy these overrides to a private local env file for local paid USDG tests.
# Do not overwrite the existing live environment or reuse its database URL.
# ORB_PAYMENT_METHOD=usdg
# New explicit selection supports both methods. Takes precedence over the legacy
# ORB_PAYMENT_METHOD switch. Native ETH price above remains unchanged.
# ORB_PAYMENT_METHODS=native_eth,usdg
# Existing populated Postgres requires an approved explicit migration BEFORE
# enabling USDG. See docs/DUAL_PAYMENTS.md; startup never adopts it silently.
# ORB_DEPLOYMENT_TARGET=usdg-staging
# ORB_CHAIN_ID=421614
# ORB_USDG_CONTRACT_ADDRESS=0xFFC95faa3d63Cde504a05B567C600B78C0b41892
# ORB_USDG_DECIMALS=6
# ORB_CREDIT_PRICE_USDG_BASE_UNITS=3000
# Configurable positive integer: 1/3/5 credits cost 0.003/0.009/0.015 test USDG.
# ORB_AI_LOCAL_TESTING=0
# ORB_CREDITS_ENABLED=1
# ORB_CREDIT_DB=api_output/orb_usdg_credits.sqlite3
# Hosted staging uses ORB_ENV=production and a NEW staging Postgres URL:
# ORB_DATABASE_URL=postgresql://<staging-user>:<staging-password>@<staging-host>:5432/<staging-database>?sslmode=require
# ORB_PUBLIC_ORIGIN=https://<exact-usdg-preview-browser-origin>
# Paxos test USDG on Arbitrum Sepolia has no monetary value; ETH pays gas.

# Public Render deployment uses dashboard environment variables, not this
# local .env file. Production uses Supabase Postgres; never use SQLite on
# Render's ephemeral filesystem. Put the connection URL only on the backend.
# ORB_ENV=production
# ORB_AI_PROVIDER=gemini
# ORB_AI_MODEL=gemini-3.5-flash-lite
# GEMINI_API_KEY=<server-side-secret>
# ORB_AI_LOCAL_TESTING=0
# ORB_CREDITS_ENABLED=1
# ORB_PUBLIC_ORIGIN=https://<orb-vercel-domain>
# ORB_DATABASE_URL=postgresql://<user>:<password>@<supabase-host>:5432/<database>?sslmode=require
# ORB_UPLOAD_DIR=/tmp/orb_uploads
# ORB_ARBITRUM_RPC_URL=https://<trusted-arbitrum-sepolia-rpc>
# ORB_CREDIT_RECEIVER=0x<dedicated-orb-testnet-wallet>

# IMPORTANT: The inherited Nimiq payment code is DISABLED in Orb by default.
# Do not set ORB_ENABLE_NIMIQ_PAYMENTS. Orb will use its own Arbitrum Sepolia
# payment and entitlement system separately.
# ORB_ENABLE_NIMIQ_PAYMENTS=

# AWS Lambda without ORB_DATABASE_URL uses a private, authoritative S3 ledger.
# Explicit deployment bootstrap creates orb-credits/ledger-v1.sqlite3 once;
# runtime never creates/resets a missing ledger or falls back to /tmp SQLite.
# ORB_AWS_S3_BUCKET=orb-opencv5-vision-2026
# Set ORB_SESSION_SECRET privately and keep it stable across deployments.
# Existing Render/Postgres balances are separate; switching API origins requires
# an explicit ledger migration. Never encode spendable balances in tokens.
